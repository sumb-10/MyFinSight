# Docker Compose 버전에서만 쓴다. 이 파일을 ".env" 로 복사하고 아래 두 값을 채운다.
# (스크립트 버전과 실행 파일 버전은 이 파일을 읽지 않는다 — 화면의 「연결 설정」에서 넣는다)
#
# .env 는 비밀번호와 같다. 다른 사람에게 보내거나 올리지 말 것.

# 팀에서 받은 DB 접속 주소 (읽기 전용 계정)
#   예: postgresql://reader:비밀번호@서버주소:5432/myfinsight?sslmode=require
DATABASE_URL=

# OpenAI API 키 (팀에서 받은 키 또는 직접 만든 키)
OPENAI_API_KEY=

# 포트를 바꾸려면 (기본 8765)
# MYFINSIGHT_PORT=8765
