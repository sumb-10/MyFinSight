.env
.env.server
# 로컬 DB·키 파일 (SQLite data/myfinsight.db 등)
/data/
# 만든 결과물 (종목 사전 등). 참조 자료 backend/data/config·reference 는 저장소에 넣음
/backend/data/processed/
# 푸시 안 하는 개인 보관 폴더 (개인 문서, 일회성·안 쓰는 코드)
/_local/
*.db
*credentials*.json
.cache/
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
# 실행 로그 (확인용, 저장소에 안 넣음)
logs/
*.log
# 비밀값: .env 외의 .env.* 도 (예시 파일만 올림)
.env.*
!.env.example
# macOS·편집기 부산물
.DS_Store
# 개인 PC 백필용 (절전 설정을 바꿈)
scripts/run_overnight.bat
# 정기 수집은 role-a-server 레포에서만 돌림 (팀 레포에서 중복 수집 방지)
.github/workflows/collect.yml