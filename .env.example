# 이 파일을 복사해 같은 폴더에 ".env" 로 저장하고 값을 채움  (copy .env.example .env)
# .env 는 비밀번호와 같음. 깃허브·메신저에 올리지 말 것 (.gitignore 에 이미 들어 있음)


# [DART] https://opendart.fss.or.kr  → 인증키 신청
DART_API_KEY=

# [한국투자증권] KIS Developers 에서 앱 키 발급. KIS_ENV = prod(실전) | vts(모의투자)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=prod

# [SEC EDGAR] 키 없음. "이름 이메일" 형식이 필수 (예: Deer Kim deer@example.com)
SEC_USER_AGENT=

# [Alpaca] https://alpaca.markets  → API Keys. ALPACA_FEED = sip | iex (sip 거부되면 자동으로 iex)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=sip

# [Tiingo] https://www.tiingo.com  → Account → API Token
TIINGO_API_KEY=

# [네이버 뉴스] NAVER_API = hub (NAVER API HUB, ncloud) | developers (developers.naver.com)
# 두 방식은 키가 서로 다름. 받은 곳에 맞춰 NAVER_API 를 고름
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API=hub

# [NewsAPI] https://newsapi.org  → API key (무료 플랜: 최근 1개월, 개발용)
NEWSAPI_KEY=

# [DB] 저장소(M02-04). AWS Lightsail PostgreSQL 주소 (lightsail_업로드.md 3절)
#   콘솔이 주는 주소를 그대로: postgresql://myfinsight:비번@엔드포인트:5432/myfinsight?sslmode=require
#   (드라이버는 psycopg 3: postgresql:// 는 postgresql+psycopg:// 로 바꿔 씀, sslmode 그대로)
#   팀원은 읽기 전용 reader 주소 (팀원_DB_사용.md)
#   분석 쪽 계정 비밀번호는 여기 두지 않고 backend/scripts/make_db_roles.py 를 돌릴 때만 환경변수로 줌
#   (MYFINSIGHT_READ_PASSWORD, MYFINSIGHT_WRITE_PASSWORD)
#   비우면 SQLite 파일 data/myfinsight.db (혼자 개발·테스트)
DATABASE_URL=
# 연결 풀 크기 (작은 DB·서버 함수는 작게. 함수는 main.py 가 2 / 0 으로 둠)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# [서버 수집 작업] jobs.py (수집작업.md). 비우면 기본값
# 대상 지수 (SP500, NDX, KOSPI200). KOSPI200 은 backend/data/config/kospi200.csv 필요 (수집작업.md 4절)
UNIVERSE_INDICES=SP500,NDX,KOSPI200
# 더 받을 종목 (티커:뉴스 검색어). 한국 종목은 이름을 같이 적어야 뉴스 검색이 됨
EXTRA_TICKERS=
# 벤치마크 (재무·뉴스는 받지 않음, assets.asset_type = ETF)
BENCHMARK_TICKERS=SPY,QQQ,069500.KS
# 벤치마크 밖 ETF (가격만 받음, asset_type = ETF). 예: TQQQ,360750.KS
ETF_TICKERS=
# 가격 출처 줄 (수집작업.md 2절). primary: KIS(한국)·ALPACA(미국), secondary: YFINANCE, 표본: TIINGO
PRICE_SOURCES=KIS,ALPACA,YFINANCE,TIINGO
# Tiingo 무료 한도(한 달 500종목) 안에서 하루에 받을 종목 수
TIINGO_DAILY_SYMBOLS=15
# 가격을 읽을 때 같은 날 출처가 여럿이면 고르는 순서 (비우면 기본값)
PRICE_PRIORITY_US=ALPACA,TIINGO,YFINANCE
PRICE_PRIORITY_KR=YFINANCE,KIS
# 가격 백필 연수, 재무 연수, 재무 다시 받는 주기(일)
# FIN_YEARS=12: 10년치 PER·ROE(TTM)를 계산하려면 그 앞 1~2년 재무가 더 필요함
BACKFILL_YEARS=10
FIN_YEARS=12
FIN_REFRESH_DAYS=7
# 가치평가 valuation_daily 를 계산할 연수 (PER·PBR·시가총액·배당수익률, 매일)
VALUATION_YEARS=10
# DART 주식 총수(stockTotqySttus)·배당(alotMatter)을 받을 보고서 (11011 사업, 11012 반기,
# 11013 1분기, 11014 3분기). 비우면 주식 총수 = 네 보고서 모두, 배당 = 사업보고서만
DART_SHARE_REPORTS=
DART_DIVIDEND_REPORTS=
# 뉴스: 정기 수집의 종목·날짜당 최대 건수 (백필에는 적용 안 함)
NEWS_PER_TICKER_DAY=5
# 뉴스 보관 일수. 0 이하 = 지우지 않음 (영구 보관). 4000 ≈ 11년
NEWS_KEEP_DAYS=0
# 출처 줄별 하루 요청 종목 수 (0 = 그 줄 끔). ALPACA_NEWS 는 ALPACA 키를 같이 씀
NEWS_DAILY_LIMITS=NAVER_NEWS=200,GOOGLE_RSS_KR=200,GOOGLE_RSS_US=200,NEWSAPI=90,ALPACA_NEWS=200
# 백필: Google News RSS 요청 간격(초). 너무 줄이면 Google 이 429 로 막음
NEWS_RSS_INTERVAL_SEC=1.5
# 백필: NewsAPI 하루 요청 한도 (무료 플랜 100, 정기 수집이 쓴 만큼 빼고 씀)
NEWSAPI_DAILY_MAX=100
# 데이터 API (인스턴스 api.py) 호출 비밀번호. 길고 무작위로
# (예: python -c "import secrets;print(secrets.token_urlsafe(32))"). 인스턴스 API 는 비우면 공개 (인스턴스_API.md 6절)
API_TOKEN=
# 인스턴스 데이터 API: 부를 수 있는 프론트 주소(쉼표, 비우면 모두), 하루에 새로 받는 종목 수
CORS_ORIGINS=
ON_DEMAND_DAILY_LIMIT=10

# 선택: 토큰·코드표 캐시 폴더 (기본 ./.cache, 서버 함수는 /tmp/myfinsight-cache)
# MYFINSIGHT_CACHE_DIR=.cache

# Copy to .env (git-ignored). Never commit real values.
OPENAI_API_KEY=sk-...

# Team news DB (AWS). Either one URL ...
# NEWS_DB_URL=postgresql://reader:PASSWORD@your-endpoint.rds.amazonaws.com:5432/DBNAME?sslmode=require
# ... or the parts:
NEWS_DB_ENGINE=postgresql        # postgresql | mysql
NEWS_DB_HOST=your-endpoint.rds.amazonaws.com
NEWS_DB_PORT=5432                # 5432 postgres / 3306 mysql
NEWS_DB_NAME=dbname
NEWS_DB_USER=reader
NEWS_DB_PASSWORD=change-me
NEWS_DB_SSL=require

# ───────────── 분석 서비스 (backend/analysis, Front) ─────────────
# LLM 모드: stub = 실제 호출 없이 미리 만든 답으로 돌려 보기 (연습·테스트) | api = OpenAI 실제 호출 (OPENAI_API_KEY 필요)
MYFINSIGHT_LLM=stub
# 보충 질문 최대 횟수 (기본 5)
ANALYSIS_MAX_QUESTIONS=5
# 실행 기록·결과·리포트를 어디에 쓸지. 비우면 로컬 파일 data/analysis_results.db (팀 DB 는 읽기만). "main" 이면 팀 DB 에 씀 (쓰기 계정 필요)
# ANALYSIS_RESULTS_DB=sqlite:///data/analysis_results.db
# ANALYSIS_STORE_DIR=data/analysis_store      # 프로필·요청·실행 목록을 저장하는 폴더
# ANALYSIS_OUTPUT_DIR=output                  # 실행별 중간 결과 JSON 폴더
# ANALYSIS_DESCRIPTOR_DIR=backend/data/processed   # 종목 사전 파일 폴더 (build_descriptor.py 가 만듦)
# ANALYSIS_MARKETS=US,KR                      # 다룰 시장
# ANALYSIS_CORS_ORIGINS=http://localhost:5173 # 화면(Front) 주소
