{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myfinsight/store/analysis_request.schema.json",
  "title": "AnalysisRequest",
  "description": "분석 요청 1건. 파일: store/data/requests/<request_id>.json. 프로필 버전 + 아이디어 + 이번 조건 변경분 + 보충 질문·답변 → 확정된 요청(effective_request). 확정(confirmed) 후에만 M0-05 큐에 들어간다 (R2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "mode",
    "profile_version",
    "idea",
    "language",
    "questions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_\\d{8}_\\d{6}_[0-9a-f]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "new",
        "rerun",
        "revision"
      ],
      "description": "new 신규 / rerun 같은 조건 재분석 / revision 수정안"
    },
    "base_report_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "rerun·revision의 기준 리포트(= run_id). new면 null"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "description": "profile.json의 versions[].version"
    },
    "idea": {
      "type": "string",
      "minLength": 5,
      "description": "자연어 아이디어 원문 (revision이면 수정 요청 원문)"
    },
    "language": {
      "type": "string",
      "default": "ko"
    },
    "overrides": {
      "type": "object",
      "description": "이번 분석에서 프로필과 다르게 적용한 조건(필드 경로 -> 값). 비어 있으면 프로필 그대로",
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "maxItems": 5,
      "description": "보충 질문 이력(한 번에 1개, 최대 5회)",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "effective_request": {
      "type": [
        "object",
        "null"
      ],
      "description": "확정된 요청 전체(UserRequest 형식: profile·capital·horizon·risk·constraints·strategy_preference·natural_language). 01_request.json의 원본",
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "draft",
        "confirmed",
        "cancelled"
      ]
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "큐 등록 후 채워짐"
    },
    "context_summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "M1-03이 LLM에 넣은 컨텍스트 패키지 요약(디버깅·재현용)"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "field",
        "kind",
        "question_ko",
        "asked_at"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "field": {
          "type": "string",
          "description": "관련 요청 필드 경로 (예: constraints.exclude_sectors)"
        },
        "kind": {
          "enum": [
            "missing",
            "conflict",
            "ambiguous"
          ]
        },
        "question_ko": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "asked_at": {
          "type": "string",
          "format": "date-time"
        },
        "answered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
