// ─────────────────────────────────────────────────────────────────────────────
// 2차 입력 : 종목 확인 + 백테스트 기간. (실제 서비스에서는 05_selection 을 화면에 보여주고
// 사용자가 확인·수정한 뒤 기간을 입력하는 단계. 이 실험에서는 이미 확인했다고 가정)
// ─────────────────────────────────────────────────────────────────────────────
{
  // 1차 요청과 같은 request_id 로 연결
  "request_id": "req_2026-10-09_001",

  "confirmation": {
    // 05_selection.json 의 종목을 사용자가 확인했는가 [HARD] (false 면 7단계 중단)
    "selection_confirmed": true,
    // 사용자가 빼달라고 한 종목
    "removed_tickers": [],
    // 사용자가 추가한 종목. 유니버스 안이어야 하며 스크린 없이 강제 포함(must_include 취급)
    "added_tickers": []
  },

  "backtest": {
    // 백테스트 시작일. 포트폴리오 구성일(as_of) = 이 날 이후 첫 거래일  [HARD]
    "start_date": "2023-04-03",
    // 백테스트 종료일 (가격 데이터 범위 안)  [HARD]
    "end_date": "2026-04-01",
    // true : 3·5단계를 start_date 기준으로 다시 돌려 종목을 재선정 (look-ahead 제거, LLM 테마·분류는 재사용)
    // false: 05 의 종목을 그대로 사용 (선정 look-ahead 가 생기며, start 이전 상장 종목만 남김)
    "reselect_at_start": true,
    // 벤치마크 티커. null 이면 1차 요청의 risk.benchmark
    "benchmark": null,
    // 월 적립(capital.monthly_contribution) 을 백테스트에 반영할지
    "include_contributions": true
  },

  "views": {
    // Black-Litterman 뷰 세트 수 = 생성할 타겟 포트폴리오 수
    "n_sets": 5,
    // 세트당 뷰 수 (절대 뷰 + 상대 뷰)
    "views_per_set": 4
  }
}
